datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Image {
  id        String    @id @default(cuid())
  filename  String    @unique
  url       String
  alt       String?
  width     Int?
  height    Int?
  size      Int?
  mimeType  String?
  createdAt DateTime  @default(now())
  posts     Post[]
  projects  Project[]
  profiles  Profile[]
}

model Post {
  id           String    @id @default(cuid())
  title        String
  slug         String    @unique
  excerpt      String?
  content      String
  status       String    @default("DRAFT")
  publishedAt  DateTime?
  coverImageId String?
  coverImage   Image?    @relation(fields: [coverImageId], references: [id])
  tags         PostTag[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, publishedAt])
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  slug  String    @unique
  posts PostTag[]
}

model PostTag {
  postId String
  tagId  String
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Project {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String
  repoUrl      String?
  demoUrl      String?
  order        Int      @default(0)
  coverImageId String?
  coverImage   Image?   @relation(fields: [coverImageId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([order])
}

model MenuItem {
  id        String     @id @default(cuid())
  label     String
  href      String
  order     Int        @default(0)
  isVisible Boolean    @default(true)
  parentId  String?
  parent    MenuItem?  @relation("MenuChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  MenuItem[] @relation("MenuChildren")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([order])
}

model Skill {
  id    String @id @default(cuid())
  name  String
  level Int?
  order Int    @default(0)
}

model Profile {
  id        Int      @id @default(1)
  name      String
  title     String
  bio       String
  email     String?
  github    String?
  linkedin  String?
  twitter   String?
  facebook  String?
  resumeUrl String?
  avatarId  String?
  avatar    Image?   @relation(fields: [avatarId], references: [id])
  updatedAt DateTime @updatedAt
}
